      sources: ["D:\\github\\CC_Site\\src\\components\\booking\\calendar-view.tsx"],
      sourcesContent: ["\"use client\";\n\nimport { useState, useEffect, useMemo } from \"react\";\nimport { DayPicker } from \"react-day-picker\";\n// DateRange type not used in this component currently\nimport { BUSINESS_RULES } from \"@/lib/validations/appointments\";\nimport \"react-day-picker/style.css\";\nimport \"@/styles/calendar.css\";\n\ninterface CalendarViewProps {\n  selectedService: {\n    id: string;\n    title: string;\n    duration: number;\n    price: number;\n  };\n  selectedDate?: Date | undefined;\n  onDateSelect: (date: Date) => void;\n  onBack: () => void;\n}\n\nexport default function CalendarView({\n  selectedService,\n  selectedDate,\n  onDateSelect,\n  onBack,\n}: CalendarViewProps) {\n  const [availableDates, setAvailableDates] = useState<Date[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Calculate date boundaries\n  const today = useMemo(() => new Date(), []);\n  const minDate = new Date(\n    today.getTime() + BUSINESS_RULES.MIN_ADVANCE_HOURS * 60 * 60 * 1000\n  );\n  const maxDate = new Date(\n    today.getTime() + BUSINESS_RULES.MAX_ADVANCE_DAYS * 24 * 60 * 60 * 1000\n  );\n\n  useEffect(() => {\n    let isMounted = true;\n\n    const fetchAvailableDates = async () => {\n      if (!selectedService?.id) return;\n\n      try {\n        if (isMounted) {\n          setLoading(true);\n          setError(null);\n        }\n\n        // Fetch available dates for the next 30 days\n        const dates: Date[] = [];\n        const promises: Promise<Response>[] = [];\n\n        for (let i = 1; i <= BUSINESS_RULES.MAX_ADVANCE_DAYS; i++) {\n          const checkDate = new Date(today);\n          checkDate.setDate(today.getDate() + i);\n          checkDate.setHours(0, 0, 0, 0);\n\n          // Skip weekends (Saturday = 6, Sunday = 0)\n          if (checkDate.getDay() === 0 || checkDate.getDay() === 6) {\n            continue;\n          }\n\n          const dateStr = che