ook Your Appointment\n          </h1>\n          <p className=\"text-lg text-muted-foreground max-w-2xl mx-auto\">\n            Schedule your counseling session with our easy-to-use booking\n            system. Choose your service, select a convenient time, and\n            we&apos;ll take care of the rest.\n          </p>\n        </div>\n\n        {/* Progress indicator */}\n        <div className=\"mb-12\">\n          <div className=\"flex items-center justify-center space-x-4 sm:space-x-8\">\n            {[\n              { step: 1, label: \"Service\" },\n              { step: 2, label: \"Date\" },\n              { step: 3, label: \"Time\" },\n              { step: 4, label: \"Details\" },\n              { step: 5, label: \"Review\" },\n            ].map(({ step, label }) => (\n              <div\n                key={step}\n                className={`flex items-center space-x-2 ${\n                  step === bookingState.step\n                    ? \"text-primary\"\n                    : step < bookingState.step\n                      ? \"text-accent\"\n                      : \"text-muted-foreground\"\n                }`}\n              >\n                <div\n                  className={`w-8 h-8 rounded-full flex items-center justify-center text-sm font-medium ${\n                    step === bookingState.step\n                      ? \"bg-primary text-background\"\n                      : step < bookingState.step\n                        ? \"bg-accent text-background\"\n                        : \"bg-muted text-muted-foreground\"\n                  }`}\n                >\n                  {step < bookingState.step ? \"\u2713\" : step}\n                </div>\n                <span className=\"text-sm font-medium hidden sm:inline\">\n                  {label}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Booking steps content */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12\">\n          {/* Step 1: Service Selection */}\n          {bookingState.step === 1 && (\n            <div className=\"lg:col-span-3\">\n              <ServiceSelector\n                selectedService={bookingState.selectedService}\n                onServiceSelect={service => {\n                  updateBookingState({\n                    selectedService: service,\n                    step: 2,\n                  });\n                }}\n              />\n            </div>\n          )}\n\n          {/* Step 2: Date Selection */}\n          {bookingState.step === 2 && bookingState.selectedService && (\n            <>\n              <div className=\"lg:col-span-2\">\n                <CalendarView\n                  selectedService={bookingState.selectedService}\n                  selectedDate={bookingState.selectedDate}\n                  onDateSelect={date => {\n                    updateBookingState({\n                      selectedDate: date,\n                      step: 3,\n                    });\n                  }}\n                  onBack={() => goToStep(1)}\n                />\n              </div>\n              <div className=\"lg:col-span-1\">\n                <div className=\"bg-muted/30 rounded-lg p-6\">\n                  <h3 className=\"font-serif text-xl font-light mb-4\">\n                    Selected Service\n                  </h3>\n                  <div className=\"space-y-2\">\n                    <p className=\"font-medium\">\n                      {bookingState.selectedService.title}\n                    </p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      {bookingState.selectedService.duration} minutes\n                    </p>\n                    <p className=\"text-lg font-medium text-primary\">\n                      ${bookingState.selectedService.price}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </>\n          )}\n\n          {/* Step 3: Time Selection */}\n          {bookingState.step === 3 &&\n            bookingState.selectedService &&\n            bookingState.selectedDate && (\n              <>\n                <div className=\"lg:col-span-2\">\n                  <TimeSlotGrid\n                    selectedService={bookingState.selectedService}\n                    selectedDate={bookingState.selectedDate}\n                    selectedTime={bookingState.selectedTime}\n                    onTimeSelect={dateTime => {\n                      updateBookingState({\n                        selectedTime: dateTime,\n                        step: 4,\n                      });\n                    }}\n                    onBack={() => goToStep(2)}\n                  />\n                </div>\n                <div className=\"lg:col-span-1\">\n                  <div className=\"bg-muted/30 rounded-lg p-6\">\n                    <h3 className=\"font-serif text-xl font-light mb-4\">\n                      Booking Summary\n                    </h3>\n                    <div className=\"space-y-4\">\n                      <div>\n                        <p className=\"text-sm text-muted-foreground\">Service</p>\n                        <p className=\"font-medium\">\n                          {bookingState.selectedService.title}\n                        </p>\n                      </div>\n                      <div>\n                        <p className=\"text-sm text-muted-foreground\">Date</p>\n                        <p className=\"font-medium\">\n                          {bookingState.selectedDate.toLocaleDateString()}\n                        </p>\n                      </div>\n                      <div>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Duration\n                        </p>\n                        <p className=\"font-medium\">\n                          {bookingState.selectedService.duration} minutes\n                        </p>\n                      </div>\n                      <div>\n                        <p className=\"text-sm text-muted-foreground\">Price</p>\n                        <p className=\"text-lg font-medium text-primary\">\n                          ${bookingState.selectedService.price}\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </>\n            )}\n\n          {/* Step 4: Client Details */}\n          {bookingState.step === 4 &&\n            bookingState.selectedService &&\n            bookingState.selectedDate &&\n            bookingState.selectedTime && (\n              <div className=\"lg:col-span-3\">\n                <BookingForm\n                  onClientDetailsSubmit={details => {\n                    updateBookingState({\n                      clientDetails: details,\n                      step: 5,\n                    });\n                  }}\n                  onBack={() => goToStep(3)}\n                />\n              </div>\n            )}\n\n          {/* Step 5: Review & Confirm */}\n          {bookingState.step === 5 &&\n            bookingState.selectedService &&\n            bookingState.selectedDate &&\n            bookingState.selectedTime &&\n            bookingState.clientDetails && (\n              <div className=\"lg:col-span-3\">\n                <BookingSummary\n                  bookingState={bookingState}\n                  onConfirm={appointmentId => {\n                    updateBookingState({\n                      appointmentId,\n                      step: 6,\n                    });\n                  }}\n                  onBack={() => goToStep(4)}\n                />\n              </div>\n            )}\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport default function AppointmentBooking() {\n  return (\n    <QueryClientProvider client={queryClient}>\n      <BookingContent />\n    </QueryClientProvider>\n  );\n}\n"],
