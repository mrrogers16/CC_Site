      sourcesContent: ["import Link from \"next/link\";\nimport { siteConfig } from \"@/lib/config/site\";\n\nconst footerLinks = {\n  services: [\n    { title: \"Individual Therapy\", href: \"/services/individual\" },\n    { title: \"Couples Counseling\", href: \"/services/couples\" },\n    { title: \"Family Therapy\", href: \"/services/family\" },\n    { title: \"Group Therapy\", href: \"/services/group\" },\n  ],\n  resources: [\n    { title: \"About\", href: \"/about\" },\n    { title: \"Blog\", href: \"/blog\" },\n    { title: \"FAQ\", href: \"/faq\" },\n    { title: \"Privacy Policy\", href: \"/privacy\" },\n  ],\n  contact: [\n    { title: \"Schedule Appointment\", href: \"/book\" },\n    { title: \"Contact Us\", href: \"/contact\" },\n    { title: \"Location\", href: \"/location\" },\n    { title: \"Emergency Resources\", href: \"/emergency\" },\n  ],\n};\n\nexport function Footer() {\n  const currentYear = new Date().getFullYear();\n\n  return (\n    <footer className=\"bg-muted border-t border-border\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n          {/* Brand */}\n          <div className=\"col-span-1 md:col-span-1\">\n            <Link href=\"/\" className=\"inline-block mb-4\">\n              <span className=\"font-serif text-2xl font-semibold text-primary\">\n                {siteConfig.name}\n              </span>\n            </Link>\n            <p className=\"text-muted-foreground text-sm leading-relaxed mb-4\">\n              Professional counseling services focused on your mental health and\n              wellbeing.\n            </p>\n            <div className=\"flex space-x-4\">\n              {/* Social links would go here */}\n            </div>\n          </div>\n\n          {/* Services */}\n          <div>\n            <h3 className=\"font-semibold text-foreground mb-4\">Services</h3>\n            <ul className=\"space-y-2\">\n              {footerLinks.services.map(link => (\n                <li key={link.href}>\n                  <Link\n                    href={link.href}\n                    className=\"text-muted-foreground hover:text-primary transition-colors duration-200 text-sm\"\n                  >\n                    {link.title}\n                  </Link>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          {/* Resources */}\n          <div>\n            <h3 className=\"font-semibold text-foreground mb-4\">Resources</h3>\n            <ul className=\"space-y-2\">\n              {footerLinks.resources.map(link => (\n                <li key={link.href}>\n                  <Link\n                    href={link.href}\n                    className=\"text-muted-foreground hover:text-primary transition-colors duration-200 text-sm\"\n                  >\n                    {link.title}\n                  </Link>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          {/* Contact */}\n          <div>\n            <h3 className=\"font-semibold text-foreground mb-4\">Contact</h3>\n            <ul className=\"space-y-2\">\n              {footerLinks.contact.map(link => (\n                <li key={link.href}>\n                  <Link\n                    href={link.href}\n                    className=\"text-muted-foreground hover:text-primary transition-colors duration-200 text-sm\"\n                  >\n                    {link.title}\n                  </Link>\n                </li>\n              ))}\n            </ul>\n            <div className=\"mt-4 text-sm text-muted-foreground\">\n              <p>Phone: (555) 123-4567</p>\n              <p>Email: info@healingpathways.com</p>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"border-t border-border mt-12 pt-8\">\n          <div className=\"flex flex-col md:flex-row justify-between items-center\">\n            <p className=\"text-muted-foreground text-sm\">\n              \xA9 {currentYear} {siteConfig.name}. All rights reserved.\n            </p>\n            <p className=\"text-muted-foreground text-sm mt-4 md:mt-0\">\n              Licensed Professional Counselor \u2022 LPC #12345\n            </p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n}\n"],
